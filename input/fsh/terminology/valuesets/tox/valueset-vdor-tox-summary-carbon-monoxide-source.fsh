ValueSet: VDORToxSummaryCarbonMonoxideSourceVS
Title: "VDOR Tox Summary Carbon Monoxide Source"
Id: vdor-tox-summary-carbon-monoxide-source-vs
Description:  "Tox Summary Carbon Monoxide source codes."
* ^experimental = true
* vdor-custom-code-system#tox-summary-carbon-monoxide-1 "Motorized vehicle (e.g., car, truck, bus, motorcycle, boat)"
* vdor-custom-code-system#tox-summary-carbon-monoxide-2 "Other"
* vdor-custom-code-system#tox-summary-carbon-monoxide-3 "Gas tool/appliance/heater"
* vdor-custom-code-system#tox-summary-carbon-monoxide-4 "Grill or barbeque (gas or charcoal, includes hibachi grills)"
* vdor-custom-code-system#tox-summary-carbon-monoxide-5 "Fire (e.g., house fire)"
* vdor-custom-code-system#tox-summary-carbon-monoxide-8 "Not applicable"
* vdor-custom-code-system#tox-summary-carbon-monoxide-9 "Unknown"